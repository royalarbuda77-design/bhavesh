# ── Database ────────────────────────────────────────────────────────────────
# SQLite database file. Defaults to ./data/app.db (created automatically).
# DATABASE_PATH=./data/app.db

# ── Security (REQUIRED in production) ───────────────────────────────────────
# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
# If unset in development, a secret is generated and stored in data/.runtime.json
# AUTH_SECRET=

# 32-byte hex key (64 hex chars) used to encrypt provider API keys at rest
# (AES-256-GCM). If unset, derived from AUTH_SECRET. Generate: openssl rand -hex 32
# ENCRYPTION_KEY=

# Public URL of this deployment (used for share links and OAuth redirects)
# APP_URL=http://localhost:3000

# ── Google OAuth login (optional) ───────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI: {APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Web search providers (optional) ─────────────────────────────────────────
# The first configured provider is used. If none are set, the agent falls back
# to a best-effort DuckDuckGo HTML scrape (may be rate limited by DuckDuckGo).
# TAVILY_API_KEY=          # https://tavily.com
# SERPER_API_KEY=          # https://serper.dev
# BRAVE_API_KEY=           # https://brave.com/search/api/

# ── Uploads ─────────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB=10

# ── Rate limits (requests per minute, server-enforced) ──────────────────────
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_CHAT=30
# RATE_LIMIT_SEARCH=20
# RATE_LIMIT_FILES=20
# RATE_LIMIT_PROVIDERS=15
