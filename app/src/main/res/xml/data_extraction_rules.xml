<?xml version="1.0" encoding="utf-8"?><!--
   JARVIS privacy policy: nothing sensitive leaves the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jarvis_settings.xml" />
        <exclude domain="file" path="memory/" />
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jarvis_settings.xml" />
    </device-transfer>
</data-extraction-rules>
